/* ============================================================
   PrismModern - Modern Minecraft Inspired QSS
   ============================================================ */

@import url("qrc:/prismmodern_ui/designsystem.css");

/* ============================================================
   Application Background
   ============================================================ */

QWidget {
    background-color: #0F1115;
    color: #FAFAFA;
    font-family: "Segoe UI", system-ui, -apple-system, sans-serif;
    font-size: 13px;
}

/* ============================================================
   Main Window
   ============================================================ */

QMainWindow {
    background-color: #0F1115;
}

#mainContainer {
    border-image: none;
    background-color: #0F1115;
    margin: 0px;
}

/* ============================================================
   Top Navigation Bar
   ============================================================ */

#navBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #1A1D23, stop:1 #0F1115);
    border: none;
    border-bottom: 1px solid #3E4451;
    padding: 0px Space_M;
    height: 56px;
    min-height: 56px;
    margin: 0px;
}

#navBar .title {
    font-size: 20px;
    font-weight: 600;
    color: #FAFAFA;
    letter-spacing: -0.5px;
}

#navBar .subtitle {
    font-size: 11px;
    color: #6E7B8B;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-left: 12px;
}

#navBar .actions {
    QToolButton {
        padding: 8px 12px;
        border-radius: 6px;
        color: #8D99A5;
        background: transparent;
        font-size: 12px;
        font-weight: 500;
        margin-left: 4px;
    }
    QToolButton:hover {
        background: #2A2D35;
        color: #FAFAFA;
    }
    QToolButton:pressed {
        background: #3A3F4A;
    }
    QToolButton:focus {
        outline: 2px solid #3DDC84;
        outline-offset: 2px;
    }
}

/* ============================================================
   Navigation Sidebar
   ============================================================ */

#navSidebar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #1A1D23, stop:1 #0F1115);
    border: none;
    border-right: 1px solid #3E4451;
    width: 200px;
    min-width: 200px;
    max-width: 240px;
    padding: 0px Space_M 0px Space_M;
}

#navSidebar .section {
    padding: Space_S 0px;
    border-bottom: 1px solid #3A3F4A;
    margin: 0px 0px Space_S 0px;
}

#navSidebar .section:last-child {
    border-bottom: none;
}

#navSidebar .section-title {
    font-size: 10px;
    color: #6E7B8B;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 500;
    padding: 4px 8px;
    margin: 0px 0px Space_S 0px;
}

#navSidebar .nav-item {
    QPushButton {
        background: transparent;
        color: #6E7B8B;
        text-align: left;
        padding: 10px 12px;
        border-radius: 6px;
        margin: 2px 4px;
        font-size: 13px;
    }
    QPushButton:hover {
        background: #2A2D35;
        color: #FAFAFA;
    }
    QPushButton:pressed {
        background: #3A3F4A;
        color: #FAFAFA;
    }
    QPushButton:checked {
        background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
            stop:0 #24272E, stop:1 #1A1D23);
        color: #3DDC84;
        font-weight: 500;
    }
    QPushButton:focus {
        outline: 2px solid #3DDC84;
        outline-offset: 2px;
    }
}

#navSidebar .nav-item:selected {
    background: qlinear-gradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #1E2229, stop:1 #15181E);
    color: #3DDC84;
}

/* ============================================================
   Content Area / Cards
   ============================================================ */

#contentArea {
    background: #0F1115;
    margin-left: 200px;
    min-width: 0;
}

.card {
    background: #1A1D23;
    border: 1px solid #3A3F4A;
    border-radius: 8px;
    margin: 8px;
    padding: 16px;
    min-width: 200px;
}

.card:hover {
    border-color: #4A4F5A;
}

.card:selected {
    border-color: #3DDC84;
    background: #24272E;
}

.card .header {
    font-size: 14px;
    font-weight: 500;
    color: #FAFAFA;
    margin: 0px 0px 8px 0px;
    padding-bottom: 8px;
    border-bottom: 1px solid #3A3F4A;
}

.card .body {
    font-size: 13px;
    color: #8D99A5;
    line-height: 1.5;
}

.card .footer {
    font-size: 11px;
    color: #6E7B8B;
    margin-top: 8px;
    padding-top: 8px;
    border-top: 1px solid #3A3F4A;
}

/* ============================================================
   Instance/Item Cards (Grid/List View)
   ============================================================ */

.instance-card {
    background: #1A1D23;
    border: 1px solid #3A3F4A;
    border-radius: 8px;
    padding: 12px 16px;
    margin: 6px 4px;
    min-height: 80px;
    transition: border-color 0.2s, background 0.2s;
}

.instance-card:hover {
    border-color: #5A606D;
    background: #24272E;
}

.instance-card:selected {
    border-color: #3DDC84;
    background: #24272E;
}

.instance-card .name {
    font-size: 13px;
    font-weight: 500;
    color: #FAFAFA;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-bottom: 4px;
}

.instance-card .version {
    font-size: 11px;
    color: #6E7B8B;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.instance-card .actions {
    QPushButton {
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 11px;
        margin-right: 4px;
    }
    QPushButton:hover {
        background: #2A2D35;
    }
    QPushButton:pressed {
        background: #3A3F4A;
    }
}

/* ============================================================
   Empty State
   ============================================================ */

.empty-state {
    QWidget {
        background: transparent;
    }
    .empty-icon {
        image: url(:/icons/empty-state.svg);
        width: 80px;
        height: 80px;
        margin: 0 auto 12px;
        color: #6E7B8B;
    }
    .empty-text {
        font-size: 14px;
        color: #6E7B8B;
        text-align: center;
        font-weight: 500;
    }
    .empty-subtext {
        font-size: 11px;
        color: #4A4F5A;
        text-align: center;
        margin-top: 4px;
    }
}

/* ============================================================
   Status Bar
   ============================================================ */

#statusBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #1A1D23, stop:1 #0F1115);
    border: none;
    border-top: 1px solid #3E4451;
    padding: 0px Space_M;
    height: 32px;
    min-height: 32px;
}

.status-bar-item {
    color: #6E7B8B;
    font-size: 11px;
}

.status-bar-item.critical {
    color: #FF5F57;
    font-weight: 500;
}

.status-bar-item.ok {
    color: #3DDC84;
    font-weight: 500;
}

/* ============================================================
   Tabs
   ============================================================ */

QTabBar {
    background: #0F1115;
    border: none;
    margin: 0px;
    padding: 0px;
}

QTabBar::tab {
    background: transparent;
    color: #6E7B8B;
    padding: 8px 16px;
    border-radius: 6px 6px 0 0;
    margin-right: 2px;
    font-size: 12px;
    font-weight: 500;
}

QTabBar::tab:selected {
    background: #1A1D23;
    color: #FAFAFA;
    border-bottom: 2px solid #3DDC84;
}

QTabBar::tab:hover:!selected {
    background: #24272E;
    color: #8D99A5;
}

/* ============================================================
   Buttons
   ============================================================ */

QPushButton {
    background: transparent;
    color: #8D99A5;
    border: 1px solid #3E4451;
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 12px;
    font-weight: 500;
    min-width: 60px;
}

QPushButton:hover {
    background: #2A2D35;
    border-color: #4A4F5A;
    color: #FAFAFA;
}

QPushButton:pressed {
    background: #3A3F4A;
    border-color: #4A4F5A;
    color: #FAFAFA;
}

QPushButton:focus {
    outline: 2px solid #3DDC84;
    outline-offset: 2px;
    background: #24272E;
}

QPushButton#primary {
    background: #3DDC84;
    color: #0F1115;
    font-weight: 600;
    border-color: #3DDC84;
}

QPushButton#primary:hover {
    background: #2ECC71;
    border-color: #2ECC71;
    color: #0F1115;
}

QPushButton#primary:pressed {
    background: #26A65C;
    border-color: #26A65C;
    color: #0F1115;
}

QPushButton#secondary {
    background: #F7DCBA;
    color: #0F1115;
    font-weight: 500;
    border-color: #F7DCBA;
}

QPushButton#secondary:hover {
    background: #E5C69E;
    border-color: #E5C69E;
    color: #0F1115;
}

QPushButton#danger {
    background: #FF5F57;
    color: #0F1115;
    font-weight: 500;
    border-color: #FF5F57;
}

QPushButton#danger:hover {
    background: #E04D4A;
    border-color: #E04D4A;
    color: #0F1115;
}

/* ============================================================
   Line Edits / Text Inputs
   ============================================================ */

QLineEdit {
    background: #1A1D23;
    border: 1px solid #3E4451;
    border-radius: 6px;
    padding: 6px 10px;
    color: #FAFAFA;
    font-size: 13px;
    selection-background-color: #3DDC84;
}

QLineEdit:hover {
    border-color: #4A4F5A;
}

QLineEdit:focus {
    border-color: #3DDC84;
    outline: none;
    background: #24272E;
}

QLineEdit:read-only {
    background: #0F1115;
    color: #6E7B8B;
}

/* ============================================================
   Group Boxes
   ============================================================ */

QGroupBox {
    color: #FAFAFA;
    border: 1px solid #3A3F4A;
    border-radius: 8px;
    margin: 8px 0px 8px 0px;
    padding-top: 12px;
}

QGroupBox::title {
    sub-control: label;
    left: 12px;
    padding: 0 4px 0 8px;
    background: #0F1115;
    border-radius: 0px 0px 4px 4px;
    color: #3DDC84;
    font-size: 13px;
    font-weight: 500;
}

/* ============================================================
   Checkboxes and Radio Buttons
   ============================================================ */

QCheckBox {
    color: #8D99A5;
    font-size: 13px;
    spacing: 6px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #3E4451;
    border-radius: 4px;
    background: #1A1D23;
}

QCheckBox::indicator:hover {
    border-color: #4A4F5A;
}

QCheckBox::indicator:checked {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #3DDC84, stop:1 #2ECC71);
    border-color: #3DDC84;
    image: url(:/icons/check white.svg);
}

QCheckBox::indicator:checked:hover {
    background: qlinear-gradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #2ECC71, stop:1 #26A65C);
}

QRadioButton {
    color: #8D99A5;
    font-size: 13px;
    spacing: 6px;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #3E4451;
    border-radius: 8px;
    background: #1A1D23;
}

QRadioButton::indicator:checked {
    background: #3DDC84;
    border-color: #3DDC84;
}

/* ============================================================
   Scrollbars
   ============================================================ */

QScrollBar:vertical {
    border: none;
    background: #1A1D23;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #3A3F4A;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #4A4F5A;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::single-handle:vertical {
    background: #3DDC84;
}

QScrollBar:horizontal {
    border: none;
    background: #1A1D23;
    height: 10px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: #3A3F4A;
    border-radius: 4px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: #4A4F5A;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* ============================================================
   Splitter
   ============================================================ */

QSplitter {
    background: #0F1115;
}

QSplitter::handle {
    background: #3A3F4A;
    width: 2px;
    margin: 0px;
}

QSplitter::handle:hover {
    background: #4A4F5A;
}

/* ============================================================
   Progress Bar
   ============================================================ */

QProgressBar {
    background: #1A1D23;
    border: 1px solid #3E4451;
    border-radius: 6px;
    text-color: #FAFAFA;
    font-size: 11px;
    padding: 2px;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #3DDC84, stop:1 #2ECC71);
    border-radius: 4px;
    margin: 1px;
}

/* ============================================================
   Combo Box
   ============================================================ */

QComboBox {
    background: #1A1D23;
    border: 1px solid #3E4451;
    border-radius: 6px;
    padding: 6px 10px;
    color: #FAFAFA;
    font-size: 13px;
    min-width: 60px;
}

QComboBox:hover {
    border-color: #4A4F5A;
}

QComboBox:focus {
    border-color: #3DDC84;
    outline: none;
    background: #24272E;
}

QComboBox QAbstractItemView {
    background: #1A1D23;
    border: 1px solid #3E4451;
    border-radius: 6px;
    padding: 4px;
    selection-background-color: #3DDC84;
}

QComboBox QAbstractItemView::item {
    padding: 6px 8px;
    color: #FAFAFA;
}

QComboBox QAbstractItemView::item:selected {
    background: #3DDC84;
    color: #0F1115;
}

/* ============================================================
   Dark Mode Override (optional - auto via Qt)
   ============================================================ */

@media (prefers-color-scheme: light) {
    QWidget {
        background-color: #FAFAFA;
        color: #0F1115;
    }
    
    #navBar {
        background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
            stop:#FAFAFA, stop:#F0F0F0);
        border-bottom: 1px solid #DDD;
    }
    
    #navSidebar {
        background: qlinear-gradient(x1:0, y1:0, x2:0, y2:1,
            stop:#FAFAFA, stop:#F0F0F0);
        border-right: 1px solid #DDD;
    }
    
    .card {
        background: #FFFFFF;
        border: 1px solid #CCCCCC;
        color: #0F1115;
    }
    
    .card .header { color: #0F1115; border-bottom: 1px solid #BBBBBB; }
    .card .body { color: #3DDC84; }
    .card .footer { color: #6E7B8B; }
    
    .instance-card {
        background: #FFFFFF;
        border: 1px solid #CCCCCC;
    }
    
    .instance-card:hover {
        border-color: #BBBBBB;
        background: #F5F5F5;
    }
    
    .status-bar-item { color: #3DDC84; }
    
    QPushButton {
        background: #0F1115;
        color: #FAFAFA;
        border: 1px solid #0F1115;
    }
    QPushButton:hover {
        background: #1A1D23;
        border-color: #1A1D23;
    }
    
    QLineEdit {
        background: #FFFFFF;
        border: 1px solid #CCCCCC;
        color: #0F1115;
    }
    QLineEdit:hover {
        border-color: #BBBBBB;
    }
    QLineEdit:focus {
        border-color: #3DDC84;
        background: #F5F5F5;
    }
    
    QGroupBox {
        border: 1px solid #CCCCCC;
        color: #0F1115;
    }
    QGroupBox::title {
        background: #FAFAFA;
        color: #3DDC84;
    }
    
    QCheckBox::indicator {
        border: 1px solid #CCCCCC;
        background: #FFFFFF;
    }
    QCheckBox::indicator:checked {
        background: #3DDC84;
        border-color: #3DDC84;
    }
    
    QRadioButton::indicator {
        border: 1px solid #CCCCCC;
        background: #FFFFFF;
    }
    QRadioButton::indicator:checked {
        background: #3DDC84;
        border-color: #3DDC84;
    }
    
    QScrollBar:vertical {
        background: #F0F0F0;
    }
    QScrollBar::handle:vertical {
        background: #CCCCCC;
    }
    QScrollBar::handle:vertical:hover {
        background: #BBBBBB;
    }
    
    QScrollBar:horizontal {
        background: #F0F0F0;
    }
    QScrollBar::handle:horizontal {
        background: #CCCCCC;
    }
    QScrollBar::handle:horizontal:hover {
        background: #BBBBBB;
    }
    
    QSplitter::handle {
        background: #CCCCCC;
    }
    QSplitter::handle:hover {
        background: #BBBBBB;
    }
    
    QProgressBar {
        background: #F0F0F0;
        border: 1px solid #CCCCCC;
    }
    QProgressBar::chunk {
        background: #3DDC84;
    }
    
    QComboBox {
        background: #FFFFFF;
        border: 1px solid #CCCCCC;
        color: #0F1115;
    }
    QComboBox:hover {
        border-color: #BBBBBB;
    }
    QComboBox:focus {
        border-color: #3DDC84;
        background: #F5F5F5;
    }
    QComboBox QAbstractItemView {
        background: #FFFFFF;
        border: 1px solid #CCCCCC;
        color: #0F1115;
    }
    QComboBox QAbstractItemView::item {
        color: #0F1115;
    }
    QComboBox QAbstractItemView::item:selected {
        background: #3DDC84;
        color: #0F1115;
    }
}